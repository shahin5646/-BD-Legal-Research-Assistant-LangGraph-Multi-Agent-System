# Copy to .env and fill in real values. Never commit .env.

# --- Required (Provide INMETECH_API_KEY or OPENAI_API_KEY) ---
# OPENAI_API_KEY=your_openai_api_key
INMETECH_API_KEY=your_inmetech_api_key
OPENAI_BASE_URL=https://api.inmetech.com/api/v1
TAVILY_API_KEY=your_tavily_api_key

# --- LangSmith tracing (optional, recommended) ---
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=langgraph-research-assistant
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- Model (optional) ---
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0
LLM_TIMEOUT=60

# --- Research behaviour (optional) ---
DEFAULT_MAX_TURNS=2
TAVILY_MAX_RESULTS=3
NOVELTY_THRESHOLD=0.3

# --- Feature Flags (optional, disable to reduce token usage) ---
ENABLE_DEBATE=true
ENABLE_SCORING=true
ENABLE_VERIFICATION=true
ENABLE_CRITIQUE=true
ENABLE_NOVELTY_CHECK=true

# --- Retry policies (optional) ---
LLM_RETRY_ATTEMPTS=3
SEARCH_RETRY_ATTEMPTS=4
RETRY_INITIAL_INTERVAL=1.0

# --- Cost reporting (optional): override pricing table if needed ---
# PRICE_INPUT_PER_1M=0.15
# PRICE_OUTPUT_PER_1M=0.60
